{
  "name": "@kolimi/laya",
  "version": "0.1.0",
  "description": "Laya — Pressure-free personal consistency tracking and rhythm engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:coverage": "vitest run --coverage src",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs src",
    "audit": "npm audit --audit-level=critical"
  },
  "keywords": [
    "kolimi",
    "laya",
    "consistency",
    "rhythm",
    "habits",
    "zero-guilt"
  ],
  "author": "Kolimi Studio",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.10",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "dependency-cruiser": "^18.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
