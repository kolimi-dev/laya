# Server Configuration
NODE_ENV=development
PORT=4001
HOST=0.0.0.0
CORS_ORIGIN=*

# Kolimi Platform JWKS Authority
JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=https://platform.kolimi.dev
JWT_AUDIENCE=kolimi_studio_apps

# Database (PostgreSQL) - Optional in dev, defaults to in-memory store if unset
DATABASE_URL=postgres://kolimi_admin:kolimi_dev_password@localhost:5432/kolimi_db
